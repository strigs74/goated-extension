{
  "manifest_version": 3,
  "name": "Fake Robux Gifter",
  "version": "1.0",
  "description": "flexflexflex i just start the day like this",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
  "https://script.google.com/*",
  "https://script.googleusercontent.com/*",
  "https://thumbnails.roblox.com/*",
  "https://www.roblox.com/*"
],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.roblox.com/upgrades/robux*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}